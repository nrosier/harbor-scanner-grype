          "ruleIndex": 10,
          "level": "warning",
          "message": {
            "text": "Artifact: charts/harbor-scanner-grype/templates/deployment.yaml\nType: helm\nVulnerability KSV-0125\nSeverity: MEDIUM\nMessage: Container adapter in deployment harbor-scanner-grype-harbor-scanner-grype (namespace: default) uses an image from an untrusted registry.\nLink: [KSV-0125](https://avd.aquasec.com/misconfig/ksv-0125)"
          },
          "locations": [
            {
