        },
        {
          "ruleId": "KSV-0003",
          "ruleIndex": 2,
          "level": "note",
          "message": {
            "text": "Artifact: charts/harbor-scanner-grype/templates/deployment.yaml\nType: helm\nVulnerability KSV-0003\nSeverity: LOW\nMessage: Container 'adapter' of Deployment 'harbor-scanner-grype-harbor-scanner-grype' should add 'ALL' to 'securityContext.capabilities.drop'\nLink: [KSV-0003](https://avd.aquasec.com/misconfig/ksv-0003)"
          },
          "locations": [
            {
              "physicalLocation": {
